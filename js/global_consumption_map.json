{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {
    "text": "Figure 1: Global Alcohol Consumption Map",
    "anchor": "start",
    "fontSize": 13
  },
  "width": 690,
  "height": 400,
  "projection": {"type": "equalEarth"},
  "data": {
    "url": "https://raw.githubusercontent.com/csur0016/2179/refs/heads/main/js/ne_110m_admin_0_countries.json",
    "format": {"type": "topojson", "feature": "ne_110m_admin_0_countries"}
  },
  "params": [
    {
      "name": "drink",
      "value": "beer_percent",
      "bind": {
        "input": "select",
        "options": ["beer_percent", "wine_percent", "spirits_percent"],
        "name": "Drink Type: "
      }
    }
  ],
  "layer": [
    {
      "transform": [
        {
          "calculate": "'Data is not available in ' + datum.properties.NAME",
          "as": "note"
        }
      ],
      "mark": {"type": "geoshape", "fill": "lightgray", "stroke": "white"},
      "encoding": {
        "tooltip": {"field": "note", "type": "nominal"}
      }
    },
    {
      "transform": [
        {
          "lookup": "properties.NAME",
          "from": {
            "data": {
              "url": "csv/global_consumption_each_type.csv"
            },
            "key": "country",
            "fields": [
              "beer_percent",
              "wine_percent",
              "spirits_percent"
            ]
          }
        },
        {
          "filter": "datum[drink] != null"
        },
        {
          "calculate": "datum[drink]",
          "as": "selected_drink_value"
        }
      ],
      "mark": {"type": "geoshape", "stroke": "white"},
      "encoding": {
        "color": {
          "field": "selected_drink_value",
          "type": "quantitative",
          "scale": {
            "type": "threshold",
            "domain": [20, 40, 60, 80],
            "range": ["#e6ae9f", "#cc8675", "#b05f4d", "#933828", "#750303"]
          },
          "legend": {"title": "Alcohol Consumption (%)"}
        },
        "tooltip": [
          {"field": "properties.NAME", "type": "nominal", "title": "Country"},
          {"field": "selected_drink_value", "type": "quantitative", "title": "Consumption (%)"}
        ]
      }
    }
  ],
  "config": {
    "view": { "stroke": "transparent" },
    "font": "sans-serif"
  }
}
