{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": 800,
  "height": 600,
  "title": "COVID-19 Cases per Country (13 Oct 2020)",
  "data": {
    "url": "https://raw.githubusercontent.com/csur0016/3179/refs/heads/main/australia_consumption.csv"
  },
  "params": [
    {
      "name": "type_selection",
      "select": {"type": "point", "fields": ["Type"]},
      "bind": {
        "input": "select",
        "options": [null, "Beer", "Wine", "Spirits", "RTD", "Cider"],
        "labels": ["Show All", "Beer", "Wine", "Spirits", "RTD", "Cider"],
        "name": "Select Beverage: "
      }
    }

  ],
  "transform": [
    {"fold": ["Beer", "Wine", "Spirits", "RTD", "Cider"], "as": ["Type", "Consumption"]},
    {"filter": {"param": "type_selection"}}
  ],
  "mark": {"type": "line", "point": true},
  "encoding": {
    "x": {
      "field": "Year",
      "type": "ordinal",
      "title": "Year"
    },
    "y": {
      "field": "Consumption",
      "type": "quantitative",
      "title": "Litres per capita",
      "scale": {"domain": [0,5]}
    },    
    "color": {
      "field": "Type",
      "type": "nominal",
      "title": "Beverage Type",
      "legend": {
      "orient": "right",
      "title": "Beverage Type",
      "symbolType": "circle" 
    }
    },
    "opacity": {
      "condition": {"param": "type_selection", "value": 1},
      "value": 0.1
    },
    "tooltip": [
      {"field": "Year", "type": "ordinal"},
      {"field": "Type", "type": "nominal"},
      {"field": "Consumption", "type": "quantitative"}
    ]
  }
}
