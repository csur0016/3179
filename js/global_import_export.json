{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": "Global Beer Consumption Map",
  "data": {
    "url": "https://raw.githubusercontent.com/csur0016/2179/refs/heads/main/global_import_export.csv"
  },
  "transform": [
    {
      "filter": "datum.GEO == 'Australia' || datum.GEO == 'Thailand' || datum.GEO == 'Canada' || datum.GEO == 'United States' || datum.GEO == 'United Kingdom' || datum.GEO == 'France'"
    },
    {
      "filter": "datum.VALUE != null && datum.VALUE != ''"
    }
  ],
  "columns": 3,
  "facet": {
    "field": "GEO",
    "type": "nominal",
    "title": "Country"
  },
  "spec": {
    "width": 250,
    "height": 250,
    "mark": {
      "type": "arc", 
      "innerRadius": 60,
      "stroke": "#fff",
      "tooltip": true
    },
    "encoding": {
      "theta": {
        "field": "VALUE",
        "type": "quantitative",
        "aggregate": "sum",
        "title": "Total Volume/Value"
      },
      "color": {
        "field": "Imports and exports",
        "type": "nominal",
        "title": "Trade Direction",
        "scale": {
          "domain": ["Imports", "Exports"],
          "range": ["#1f77b4", "#ff7f0e"] 
        }
      }
    }
  }
}